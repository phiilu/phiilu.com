---
import { Container } from '@components/react/Container';
import { Heading } from '@components/react/Heading';
import { getCollection } from 'astro:content';
import { PostListItem } from '@components/react/PostListItem';
import Hero from '@components/Hero.astro';
import Layout from '@/layouts/Page.astro';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 5);
---

<Layout>
  <Container as="main" noMargin className="md:px-4 space-y-14">
    <Hero />
    <div class="space-y-8 md:space-y-14">
      <Heading as="h2" size="h3" noMargin className="px-4">Latest Articles</Heading>
      <ul class="space-y-16 md:space-y-8">
        {
          posts.map((post, index) => (
            <li style={`--post-index: ${index}`}>
              <PostListItem
                post={{
                  ...post.data,
                  slug: post.id
                }}
              />
            </li>
          ))
        }
      </ul>
      <a
        href="/blog"
        class="inline-flex items-center gap-1 px-4 font-medium text-indigo-600 transition-colors dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300"
      >
        Visit my blog <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </Container>
</Layout>
