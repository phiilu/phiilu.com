---
import { Heading } from '@react/Heading';
import { Image } from 'astro:assets';
import { techIcons } from '@/helpers/techIcons';
import profileImage from '@assets/images/me.jpg';

// Brand-derived colours rather than the raw brand hex: React's #61DAFB and
// Elixir's #4B275F each fail contrast in one of the two themes.
const techs = [
  {
    name: 'React',
    icon: 'React',
    href: 'https://react.dev/',
    color: 'text-sky-600 dark:text-sky-400',
    after: ' frontends, today I build native iOS apps at '
  },
  {
    name: 'Untis',
    icon: 'Untis',
    href: 'https://www.untis.at/',
    color: 'text-[#FF6033]',
    after: ' with '
  },
  {
    name: 'Swift',
    icon: 'Swift',
    href: 'https://www.swift.org/',
    color: 'text-orange-600 dark:text-orange-400',
    after: ', and my side projects run on '
  },
  {
    name: 'Elixir',
    icon: 'Elixir',
    href: 'https://elixir-lang.org/',
    color: 'text-violet-700 dark:text-violet-400',
    after: ' and '
  },
  {
    name: 'Phoenix/Ash',
    icon: 'Phoenix',
    href: 'https://www.phoenixframework.org/',
    color: 'text-orange-700 dark:text-orange-300',
    after: ', with '
  },
  {
    name: 'TypeScript',
    icon: 'TypeScript',
    href: 'https://www.typescriptlang.org/',
    color: 'text-blue-600 dark:text-blue-400',
    after: ' and '
  },
  {
    name: 'Svelte/SvelteKit',
    icon: 'Svelte',
    href: 'https://svelte.dev/',
    color: 'text-red-600 dark:text-red-400',
    after: ' never far away.'
  }
];
---

<section class="px-4 py-6 md:py-10">
  <div class="flex flex-col items-start gap-6 md:flex-row md:items-start md:gap-10">
    <picture class="relative self-center flex-none w-32 h-32 md:self-start md:w-56 md:h-56">
      <Image
        class="absolute object-cover w-32 h-32 rounded-full md:w-56 md:h-56 ring-1 ring-black/5 dark:ring-white/10"
        src={profileImage}
        alt="Me"
        width={352}
        quality={100}
      />
    </picture>

    <div class="max-w-2xl">
      <div class="flex flex-wrap items-center gap-x-3">
        <Heading noMargin size="h2" as="h1">Hey, I&apos;m Florian</Heading>
        <a
          class="px-2 py-1 text-base font-medium text-gray-600 transition-colors duration-200 ease-in-out rounded-md bg-slate-100 dark:bg-gray-800 dark:text-gray-300 hover:bg-indigo-100 hover:text-indigo-700 dark:hover:bg-indigo-500/20 dark:hover:text-indigo-300"
          href="https://bsky.app/profile/phiilu.com"
        >
          @phiilu
        </a>
      </div>

      <div
        class="mt-5 space-y-6 text-lg leading-relaxed text-gray-600 xl:text-xl xl:leading-relaxed dark:text-gray-300"
      >
        <p>
          A developer from{' '}
          <span class="relative inline-block group/austria">
            Austria
            {/* Hover unfurls the flag: red-white-red, wiping in from the left. */}
            <span
              aria-hidden="true"
              class="absolute left-0 w-full origin-left transition-transform duration-300 ease-out scale-x-0 rounded-xs -bottom-1 h-1.5 group-hover/austria:scale-x-100 bg-[linear-gradient(to_bottom,#ED2939_0_33.3%,#fff_33.3%_66.6%,#ED2939_66.6%)]"
            >
            </span>
          </span>, curious and{' '}
          <button
            type="button"
            popovertarget="t-shaped"
            class="font-medium text-gray-900 underline cursor-pointer decoration-dotted underline-offset-4 dark:text-gray-100 [anchor-name:--t-shaped]"
          >
            T-shaped</button
          >, always happy to go the extra mile to learn something new.
        </p>
        <p>
          I started out building{' '}
          {
            techs.map((tech) => (
              <>
                <a
                  href={tech.href}
                  class={`whitespace-nowrap font-medium hover:underline ${tech.color}`}
                >
                  {tech.icon && (
                    <svg
                      viewBox={techIcons[tech.icon].viewBox}
                      aria-hidden="true"
                      class="inline-block w-[1em] h-[1em] mr-1 align-[-0.125em] fill-current"
                    >
                      {techIcons[tech.icon].paths.map((d) => (
                        <path d={d} />
                      ))}
                    </svg>
                  )}
                  {tech.name}
                </a>
                {tech.after}
              </>
            ))
          }
        </p>
        <p>I self-host what I can, and I&apos;m trying to get back into writing about it here.</p>
      </div>
    </div>
  </div>

  <div
    id="t-shaped"
    popover
    class="max-w-sm p-4 text-base leading-relaxed text-gray-600 bg-white border-0 rounded-lg shadow-2xl dark:text-gray-300 dark:bg-gray-800 ring-1 ring-black/10 dark:ring-white/10 [position-anchor:--t-shaped] [position-area:block-end_span-inline-end] [margin-block:0.5rem]"
  >
    <p class="mb-1 font-semibold text-gray-900 dark:text-gray-100">T-shaped</p>
    <p>
      Broad across a lot of ground (servers, Kubernetes, CI/CD, web, React Native, PHP/Laravel) with
      the deep stroke of the T in native iOS at work, and in Elixir and Phoenix on my own time.
    </p>
  </div>
</section>

<script>
  // The popover attribute gives click, Esc and light-dismiss for free; hover is
  // the one trigger it has no declarative form for.
  document.addEventListener('astro:page-load', () => {
    const trigger = document.querySelector<HTMLButtonElement>('[popovertarget="t-shaped"]');
    const popover = document.getElementById('t-shaped');
    if (!trigger || !popover) return;

    let timer: ReturnType<typeof setTimeout>;
    const show = () => {
      clearTimeout(timer);
      if (!popover.matches(':popover-open')) popover.showPopover();
    };
    // A grace period so the pointer can travel from the word to the box.
    const hide = () => {
      timer = setTimeout(() => {
        if (popover.matches(':popover-open')) popover.hidePopover();
      }, 200);
    };

    if (!window.matchMedia('(hover: hover)').matches) return;
    for (const element of [trigger, popover]) {
      element.addEventListener('mouseenter', show);
      element.addEventListener('mouseleave', hide);
    }
  });
</script>
