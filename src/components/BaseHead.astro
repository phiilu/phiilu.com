---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '@styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  publishedDate?: Date;
}

function removeTrailingSlash(str: string) {
  return str.replace(/\/+$/, '');
}

const ogImageBaseUrl = 'https://og-image.phiilu.com/';
const canonicalUrl = removeTrailingSlash(new URL(Astro.url.pathname, Astro.site).toString());

const { title, description, image = '/api/og', keywords, publishedDate } = Astro.props;
---

<ClientRouter />

<meta name="theme-color" content="#ffffff" />

<!-- Apply the saved preferences before first paint, so there is no flash of
the wrong theme and no animation the reader asked not to see. -->
<script is:inline>
  (() => {
    const darkMedia = window.matchMedia('(prefers-color-scheme: dark)');
    const motionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
    const apply = () => {
      const root = document.documentElement;
      const theme = localStorage.getItem('theme') ?? 'system';
      const dark = theme === 'dark' || (theme === 'system' && darkMedia.matches);
      root.classList.toggle('dark', dark);
      // Keeps the mobile browser chrome from staying white in dark mode.
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', dark ? '#101828' : '#ffffff');
      const motion = localStorage.getItem('reduce-motion');
      root.classList.toggle(
        'reduce-motion',
        motion === null ? motionMedia.matches : motion === 'true'
      );
    };
    apply();
    // This script re-runs on every swap, so bind the listeners only once.
    if (!window.__preferenceListenersBound) {
      window.__preferenceListenersBound = true;
      // Keeps the "follow the system" settings live while the page is open.
      darkMedia.addEventListener('change', apply);
      motionMedia.addEventListener('change', apply);
      // The ClientRouter replaces the <html> attributes on navigation, which
      // drops the classes again.
      document.addEventListener('astro:after-swap', apply);
    }
  })();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="phiilu.com RSS Feed" href="/rss.xml" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
<link rel="manifest" href="/images/favicon/site.webmanifest" />
<link rel="mask-icon" href="/images/favicon/safari-pinned-tab.svg" color="#818cf8" />
<link rel="shortcut icon" href="/images/favicon/favicon.ico" />
<meta name="msapplication-TileColor" content="#ffffff" />
<meta name="msapplication-config" content="/images/favicon/browserconfig.xml" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Primary Meta Tags -->
<title>
  {title ?? SITE_TITLE}
</title>
<meta name="title" content={title ?? SITE_TITLE} />
<meta name="author" content="Florian Kapfenberger" />
<meta name="description" content={description || SITE_DESCRIPTION} />
{keywords && <meta name="keywords" content={keywords} />}
{publishedDate && <meta name="article:published_time" content={publishedDate.toISOString()} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title || SITE_TITLE} />
<meta property="og:description" content={description || SITE_DESCRIPTION} />
{image && <meta property="og:image" content={new URL(image, ogImageBaseUrl)} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title || SITE_TITLE} />
<meta property="twitter:description" content={description || SITE_DESCRIPTION} />
{image && <meta property="twitter:image" content={new URL(image, ogImageBaseUrl)} />}
