---
import { Container } from '@components/react/Container';
import { GearCategoryIcons } from '@components/react/icons/GearCategoryIcons';
import { getCollection, render } from 'astro:content';
import { Heading } from '@components/react/Heading';
import { SITE_TITLE } from '@/consts';
import Layout from '@/layouts/Page.astro';
import {
  GearItem,
  type GearCollectionEntryRendered,
  SoftwareGearItem
} from '@components/react/GearItem';

const gear = await getCollection('gear');

const gearRendered: GearCollectionEntryRendered[] = [];

for (const g of gear) {
  const { Content } = await render(g);
  gearRendered.push({
    ...g,
    Content
  });
}

const gearByCategory: Record<string, GearCollectionEntryRendered[]> = {};

for (const gearItem of gearRendered) {
  // The schema allows a missing category; such an item has no section to go in.
  const { category } = gearItem.data;
  if (!category) continue;
  gearByCategory[category] ??= [];
  gearByCategory[category].push(gearItem);
}

for (const items of Object.values(gearByCategory)) {
  items.sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity));
}

const sortedGearByCategory = {
  Desk: gearByCategory.Desk,
  Audio: gearByCategory.Audio,
  Software: gearByCategory.Software,
  'Everyday Carry': gearByCategory['Everyday Carry']
};
---

<Layout title={`My Gear / Uses | ${SITE_TITLE}`}>
  <Container as="main">
    <div class="space-y-12 md:px-4">
      <Heading noMargin>My Gear</Heading>
      <p class="text-lg">
        Inspired by{' '}
        <a class="font-bold text-indigo-600 dark:text-indigo-400" href="https://uses.tech/">
          many others</a
        >{' '}
        I created a list on hardware, software and equipment I use daily to make my life easier.
      </p>

      {
        Object.entries(sortedGearByCategory).map(([category, gears]) => {
          return (
            <div class="relative space-y-4">
              <Heading size="h2" className="flex items-center">
                <GearCategoryIcons category={category} />
                {category}
              </Heading>
              <ul
                class={
                  category === 'Software'
                    ? 'grid gap-6 sm:grid-cols-2 lg:grid-cols-3'
                    : 'grid gap-12 md:grid-cols-2'
                }
              >
                {gears.map((gear) => {
                  if (gear.data.category === 'Software') {
                    return (
                      <li>
                        <SoftwareGearItem gear={gear}>
                          <gear.Content />
                        </SoftwareGearItem>
                      </li>
                    );
                  }

                  return (
                    <li>
                      <GearItem gear={gear}>
                        <gear.Content />
                      </GearItem>
                    </li>
                  );
                })}
              </ul>
            </div>
          );
        })
      }
    </div>
  </Container>
</Layout>
