---
import { Newsletter } from '@components/react/Newsletter';
import { Notifications } from '@components/react/Notifications';
import { PageBanner } from '@components/react/PageBanner';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';

// A short crossfade: no movement, so text never slides under the reader.
const fadeThrough = {
  old: { name: 'page-fade-out', duration: '0.12s', easing: 'ease-out', fillMode: 'both' },
  new: { name: 'page-fade-in', duration: '0.18s', easing: 'ease-out', fillMode: 'both' }
};
const pageTransition = { forwards: fadeThrough, backwards: fadeThrough };

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  publishedDate?: Date;
  hide?: string[];
}

const { title, description, keywords, publishedDate, image, hide } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      keywords={keywords}
      publishedDate={publishedDate}
      image={image}
    />
  </head>
  <body>
    <PageBanner client:only="react" />
    <div
      class="grid min-h-screen antialiased font-open-sans dark:bg-gray-900 dark:text-gray-100"
      style={{ gridTemplateRows: 'auto 1fr auto' }}
    >
      <Header />
      <div transition:animate={pageTransition}>
        <slot />
      </div>
      {!hide?.includes('Newsletter') && <Newsletter client:idle />}
      <Footer />
    </div>
    <Notifications client:idle />
  </body>
</html>
